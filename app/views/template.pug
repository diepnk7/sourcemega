extends layout/layout

block vars
    -title = 'NamePage'
    -mainClass = 'page-template'
    -bodyClass = ''
    -hdClass = ''

block container 
    //- +popup("popSearch","srch")
    //-     .content 
    //-         form(action="")
    //-             .content-form 
    //-                 input(type="text" placeholder="Tìm kiếm")
    //-                 +btn("Tìm kiếm","button","second")

    +banner("Sản phẩm dân dụng",[{txt:"Sản phẩm dân dụng"}],"banner.jpg")

    span.btn.popup-open(data-popup='srch')
        span.txt Popup Search

    .popup(data-popup-id='srch')
        .popup-overlay
        .popup-main.popSearch
            .popup-main-wrapper
                .popup-over
                    .popup-wrapper
                        .content
                            form(action)
                                .content-form
                                    input(type='text' placeholder='Tìm kiếm')
                                    button.btn.second(type='submit')
                                        span.txt Tìm kiếm
            .popup-close
                i.fas.fa-times.icon

    .head.t-center
        //- +tts("SẢN PHẨM DÂN DỤNG","Sản phẩm của công ty gồm: máy nước nóng năng lượng mặt trời, điện năng lượng mặt trời, bơm nhiệt, bồn bảo ôn, bồn nước inox,.. và các thiết bị & phụ kiện hỗ trợ khác.")
        .title 
            .title-second(data-spl).load-img.js-add SẢN PHẨM DÂN DỤNG load-img
            .title-second(data-spl).load-img-second.js-add SẢN PHẨM DÂN DỤNG load-img-second
            .title-second(data-spl).load-img-third.js-add SẢN PHẨM DÂN DỤNG load-img-third
            .title-second(data-spl).txt-focus.js-add SẢN PHẨM DÂN DỤNG txt-focus 
            .title-second(data-spl).txt-animated.js-add SẢN PHẨM DÂN DỤNG txt-animated
            .title-second(data-spl).txt-spl.js-add SẢN PHẨM DÂN DỤNG txt-spl
            .title-second(data-spl).scroll-item.js-add SẢN PHẨM DÂN DỤNG scroll-item
            .title-second(data-spl).text-hori.js-add SẢN PHẨM DÂN DỤNG text-hori
            .title-second(data-spl).text-verti.js-add SẢN PHẨM DÂN DỤNG text-verti
            .title-second(data-spl).text-scale.js-add SẢN PHẨM DÂN DỤNG text-scale
            .title-second(data-spl).fx-letter.js-add SẢN PHẨM DÂN DỤNG fx-letter


    .container
        .ss-pd 
            .prod-list.row 
                -
                    var arrs = [
                        {
                            img:"pr1.jpg",
                            tt:"Máy nước nóng ống chân không thu nhiệt",
                            des:"Sản phẩm đã đạt chứng nhận phù hợp tiêu chuẩn Châu Âu (CE mark) đủ tiêu chuẩn xuất khẩu vào thị trường liên minh Châu ",
                        },
                        {
                            img:"pr2.jpg",
                            tt:"Máy nước nóng ống chân không thu nhiệt",
                            des:"Sản phẩm đã đạt chứng nhận phù hợp tiêu chuẩn Châu Âu (CE mark) đủ tiêu chuẩn xuất khẩu vào thị trường liên minh Châu ",
                        },
                        {
                            img:"pr3.jpg",
                            tt:"Máy nước nóng ống chân không thu nhiệt",
                            des:"Sản phẩm đã đạt chứng nhận phù hợp tiêu chuẩn Châu Âu (CE mark) đủ tiêu chuẩn xuất khẩu vào thị trường liên minh Châu ",
                        },
                    ]
                each val in arrs 
                    .col.col-4 
                        +prodItem(val.img,val.tt,val.des) 
            +pageNumber

    .list 
        each i in Array(5)
            .item 
                .img
                    .inner
                        +img("product.jpg")
                .content 
                    h3.name 
                        a(href="") Hoa qua
                    p.des hoa qua tuoi
    .container
        .form-list.row
            .form-ip.col.per5
                span.text Họ và Tên
                input(type='text' placeholder)
            .form-ip.col.per5
                span.text Số điện thoại
                    span.red *
                input(type='text' placeholder)
            .form-ip.col.per5
                span.text
                    | Ngày giao hàng
                .dateTime(data-type='single')
                    .dateTimeItem
                        .dateTimeText dd/mm/yyyy
                        input.dateTimeInput(type='text')
                    img(src='./assets/images/ic-calendar.svg' alt)
            .form-ip.col.per5
                span.text Khung giờ giao hàng
                select.re-select-main(name)
                    option(value)  Chọn khung giờ
                    option(value)  Chọn khung giờ
                    option(value)  Chọn khung giờ
                    option(value)  Chọn khung giờ
            .form-ip.col.per5
                span.text Địa chỉ giao hàng
                input(type='text' placeholder)
            .form-ip.col.per5
                span.text Ghi chú địa chỉ
                input(type='text' placeholder)
            .form-ip.col
                span.text Ghi chú
                textarea(name placeholder='Ghi chú của bạn')  
            .form-ip.col
                label.form-checker
                    input(type='checkbox')
                    span.sqr  
                    span.txt Bạn muốn người thân nhận hàng
            .form-ip.col.per5
                span.text Tên người nhận
                input(type='text' placeholder)
            .form-ip.col.per5
                span.text Số điện thoại người nhận
                input(type='text' placeholder)
