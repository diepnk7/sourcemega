header.hd
  .hd-wr
    .hd-flex 
      .hd-logo 
        a(href="").custom-logo-link 
          +img("logo.png") 
      .hd-nav
        .menu-nav
          ul.menu-list
            li.menu-item.current-menu-item
              a.menu-link(href="") Về chúng tôi
            li.menu-item
              a.menu-link(href="") Dân dụng
            li.menu-item.dropdown
              a.menu-link(href="") Dự án
              ul.menu-list
                li.menu-item.dropdown
                  a.menu-link(href="") Dự án 1
                  ul.menu-list
                    li.menu-item
                      a.menu-link(href="") Dự án 1 1
                    li.menu-item
                      a.menu-link(href="") Dự án 1 2
                li.menu-item
                  a.menu-link(href="") Dự án 2
            li.menu-item
              a.menu-link(href="") Tin tức
            li.menu-item
              a.menu-link(href="") Liên hệ
      .hd-act
        .hd-srch 
          .hd-srch-it 
            +img("ic-srch.svg")
            span.txt Tìm kiếm
          .hd-srch-ip 
            form(action="")
              .hd-srch-flex 
                input(type="text", placeholder="Tìm kiếm") 
                button 
                  +img("ic-srch.svg")
        .hd-lg 
          a(href="").hd-lg-it.active VN 
          a(href="").hd-lg-it EN 
      .burger
        #hamburger.hamburger
          svg.ham(viewbox='0 0 100 100' width='40')
            path.line.top(d='m 30,33 h 40 c 0,0 9.044436,-0.654587 9.044436,-8.508902 0,-7.854315 -8.024349,-11.958003 -14.89975,-10.85914 -6.875401,1.098863 -13.637059,4.171617 -13.637059,16.368042 v 40')
            path.line.middle(d='m 30,50 h 40')
            path.line.bottom(d='m 30,67 h 40 c 12.796276,0 15.357889,-11.717785 15.357889,-26.851538 0,-15.133752 -4.786586,-27.274118 -16.667516,-27.274118 -11.88093,0 -18.499247,6.994427 -18.435284,17.125656 l 0.252538,40')
  .mobile-overlay
  .mobile
    .mobile-con
      .mobile-wr
        .mobile-log 
          .hd-srch-ip 
            form(action="")
              .hd-srch-flex 
                input(type="text", placeholder="Tìm kiếm") 
                button 
                  +img("ic-srch.svg")
        .mobile-nav
          .menu-nav
            ul.menu-list
              li.menu-item
                a.menu-link(href='')
                  | Giới thiệu
              li.menu-item
                a.menu-link(href='')
                  | Sản phẩm
              li.menu-item.dropdown
                a.menu-link(href='')
                  | Dự án
                ul.menu-list
                  li.menu-item.dropdown
                    a.menu-link(href="") Dự án 1
                    ul.menu-list
                      li.menu-item
                        a.menu-link(href="") Dự án 1 1
                      li.menu-item
                        a.menu-link(href="") Dự án 1 2
                  li.menu-item
                    a.menu-link(href='')
                      | Dự án 2
              li.menu-item
                a.menu-link(href='')
                  | Liên hệ
          .mobile-content
            p.titles Mạng xã hội 
            .social 
              a(href="").social-link  
                +img("ic-fb.svg") 
              a(href="").social-link 
                +img("ic-twi.svg") 
              a(href="").social-link 
                +img("ic-linked.svg") 
            p.titles Thông Tin
            .mobile-content-bl
              .name
                span.ic
                  i.fa-solid.fa-phone
                span.name-txt Hotline:
              .val
                | 123456789
            .mobile-content-bl
              .name
                span.ic
                  i.fa-solid.fa-envelope
                span.name-txt Mail:
              .val
                | themona@gmail.com
            .mobile-content-bl
              .name
                span.ic
                  i.fa-solid.fa-location-dot
                span.name-txt Address:
              .val
                | mona.media

